---
import Base from './Base.astro';

interface Props {
  title: string;
  date: Date;
  description: string;
}

const { title, date, description } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={title} description={description}>
  <article class="post">
    <header class="post-header">
      <h1>{title}</h1>
      <time datetime={date.toISOString().split('T')[0]} class="post-date">
        {formattedDate}
      </time>
    </header>
    <div class="post-body">
      <slot />
    </div>
  </article>
</Base>

<style>
  .post-header {
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }

  .post-header h1 {
    margin-top: 0;
    margin-bottom: 8px;
  }

  .post-date {
    display: block;
    color: var(--text);
    font-size: 14px;
    letter-spacing: 0.02em;
  }

  .post-body {
    max-width: 680px;
    line-height: 1.75;
  }

  .post-body :global(h2),
  .post-body :global(h3) {
    margin-top: 2em;
  }

  .post-body :global(pre) {
    background: var(--code-bg);
    border-radius: 8px;
    padding: 20px;
    overflow-x: auto;
    border: 1px solid var(--border);
  }

  .post-body :global(pre code) {
    background: none;
    padding: 0;
    font-size: 14px;
  }

  .post-body :global(blockquote) {
    margin-inline: 0;
    padding-inline: 20px;
    border-left: 3px solid var(--accent);
    color: var(--text);
    font-style: italic;
  }
</style>
