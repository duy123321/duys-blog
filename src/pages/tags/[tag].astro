---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tagSet = new Set(posts.flatMap((post) => post.data.tags ?? []));
  return [...tagSet].map((tag) => ({
    params: { tag },
    props: {
      posts: posts
        .filter((post) => post.data.tags?.includes(tag))
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`#${tag} — Duy Nguyen`} description={`Posts tagged "${tag}"`}>
  <div class="tag-index">
    <h1><span class="tag-label">{tag}</span></h1>
    <p class="post-count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>

    <ul class="post-list">
      {posts.map((post) => (
        <li class="post-item">
          <a href={`/blog/${post.id}`} class="post-link">
            <span class="post-title">{post.data.title}</span>
            <time
              datetime={post.data.date.toISOString().split('T')[0]}
              class="post-date"
            >
              {post.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            {post.data.description && (
              <p class="post-description">{post.data.description}</p>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .tag-index h1 {
    margin-top: 0;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .tag-label {
    font-size: 28px;
  }

  .post-count {
    font-size: 14px;
    color: var(--text);
    margin-top: 0;
    margin-bottom: 40px;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-item {
    border-bottom: 1px solid var(--border);
  }

  .post-item:first-child {
    border-top: 1px solid var(--border);
  }

  .post-link {
    display: block;
    padding-block: 20px;
    color: inherit;
    text-decoration: none;
    transition: padding-left 0.2s;
  }

  .post-link:hover {
    padding-left: 8px;
    text-decoration: none;
  }

  .post-title {
    display: block;
    font-size: 18px;
    font-weight: 500;
    color: var(--text-h);
    margin-bottom: 4px;
  }

  .post-date {
    display: block;
    font-size: 13px;
    color: var(--text);
    margin-bottom: 8px;
  }

  .post-description {
    font-size: 15px;
    color: var(--text);
    margin: 0;
  }
</style>
