---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags ?? []))].sort();
---

<Base
  title="Blog — Duy Nguyen"
  description="Writing about software, side projects, and whatever else is on my mind."
>
  <div class="blog-index">
    <h1>Blog</h1>

    {allTags.length > 0 && (
      <div class="topics">
        <h2 class="topics-label">Search by Topic</h2>
        <div class="topics-list">
          {allTags.map((tag) => (
            <a href={`/tags/${tag}`} class="topic-tag">{tag}</a>
          ))}
        </div>
      </div>
    )}

    {posts.length === 0 && <p>No posts yet. Check back soon.</p>}

    <ul class="post-list">
      {posts.map((post) => (
        <li class="post-item">
          <a href={`/blog/${post.id}`} class="post-link">
            <span class="post-title">{post.data.title}</span>
            <time
              datetime={post.data.date.toISOString().split('T')[0]}
              class="post-date"
            >
              {post.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            {post.data.description && (
              <p class="post-description">{post.data.description}</p>
            )}
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="post-tags">
                {post.data.tags.map((tag: string) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .blog-index h1 {
    margin-top: 0;
    margin-bottom: 24px;
  }

  .topics {
    margin-bottom: 40px;
  }

  .topics-label {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
    margin: 0 0 10px;
  }

  .topics-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .topic-tag {
    font-size: 13px;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 4px 12px;
    text-decoration: none;
    letter-spacing: 0.03em;
  }

  .topic-tag:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-item {
    border-bottom: 1px solid var(--border);
  }

  .post-item:first-child {
    border-top: 1px solid var(--border);
  }

  .post-link {
    display: block;
    padding-block: 20px;
    color: inherit;
    text-decoration: none;
    transition: padding-left 0.2s;
  }

  .post-link:hover {
    padding-left: 8px;
    text-decoration: none;
  }

  .post-title {
    display: block;
    font-size: 18px;
    font-weight: 500;
    color: var(--text-h);
    margin-bottom: 4px;
  }

  .post-date {
    display: block;
    font-size: 13px;
    color: var(--text);
    margin-bottom: 8px;
  }

  .post-description {
    font-size: 15px;
    color: var(--text);
    margin: 0;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }

  .tag {
    font-size: 12px;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 2px 8px;
    letter-spacing: 0.03em;
  }
</style>
